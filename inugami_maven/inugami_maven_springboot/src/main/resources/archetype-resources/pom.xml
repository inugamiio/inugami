        <sonar.dynamicAnalysis>reuseReports</sonar.dynamicAnalysis>
        <jacoco.report.path.relative>../</jacoco.report.path.relative>
        <sonar.coverage.jacoco.xmlReportPaths>${project.basedir}/${jacoco.report.path.relative}/target/</sonar.coverage.jacoco.xmlReportPaths>
        <sonar.language>java</sonar.language>

        <custom.sonar.coverage.exclusions></custom.sonar.coverage.exclusions>
        <sonar.exclusions>
            **/js/vendors.js,
            **/*Exception*,
            **/vendors/**/*,
            **/test/*,
            **/test_it/*,
            **/*Configuration.java
        </sonar.exclusions>
        <sonar.coverage.exclusions>
            **/test/*,
            **/test_it/*,
            **/js/vendors.js,
            **/generated-sources/**/*,
            **/generated-test-sources/**/*,
            **/*Context.java,
            **/*Application.java
            ${custom.sonar.coverage.exclusions}
        </sonar.coverage.exclusions>
        <sonar.cpd.exclusions>
            **/*DTO.java,
            **/*API.java,
            **/*Entity.java,
            **/api/**/I*.java
        </sonar.cpd.exclusions>

        <maven-owasp.enabled>false</maven-owasp.enabled>
