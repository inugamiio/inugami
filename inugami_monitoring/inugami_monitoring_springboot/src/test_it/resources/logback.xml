<?xml version="1.0" encoding="UTF-8"?>
<configuration>


    <appender name="logTest" class="io.inugami.commons.test.logs.LogTestAppender">
        <encoder class="io.inugami.logs.obfuscator.encoder.ObfuscatorEncoder">
            <configuration>
                <forceNewLine>true</forceNewLine>
            </configuration>
            <pattern>%d{dd/MM HH:mm:ss} %5p [%c:%L] - %m%n</pattern>
        </encoder>
    </appender>


    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="io.inugami.logs.obfuscator.encoder.ObfuscatorEncoder">
            <configuration>
                <forceNewLine>true</forceNewLine>
            </configuration>
            <pattern>%d{dd/MM HH:mm:ss} %5p [%c:%L] - %m%n</pattern>
        </encoder>
    </appender>
    <appender name="DEFAULT_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{dd/MM HH:mm:ss} %5p [%c:%L] - %m%n</pattern>
        </encoder>
    </appender>

    <logger name="io.restassured">
        <level value="WARN"/>
    </logger>
    <logger name="ch.qos.logback">
        <level value="WARN"/>
    </logger>
    <logger name="org.springframework">
        <level value="INFO"/>
    </logger>
    <logger name="org.apache">
        <level value="INFO"/>
    </logger>

    <logger name="org.eclipse.jetty">
        <level value="WARN"/>
        <appender-ref ref="STDOUT"/>
    </logger>

    <logger name="io.inugami.commons.test.UnitTestHelperText">
        <level value="DEBUG"/>
        <appender-ref ref="DEFAULT_STDOUT"/>
    </logger>

    <root level="DEBUG">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="logTest"/>
    </root>

</configuration>